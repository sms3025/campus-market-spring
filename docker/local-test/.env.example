DB_PASSWORD=local-only-password
DB_ROOT_PASSWORD=local-root-only
GRAFANA_PASSWORD=local-grafana-only
SEED_SCALE=smoke
SEED_DISTRIBUTION=uniform
SEED_RANDOM=3025
SEED_FANOUT=1
FCM_REAL=false
FCM_DELAY_MS=0
# Real Firebase: put firebase.json in this directory, never in Git.
FIREBASE_SECRETS_DIR=./docker/local-test/secrets
# IntelliJ mode only:
# BASE_URL=http://host.docker.internal:8080
# PROMETHEUS_CONFIG=./docker/local-test/prometheus/host.yml
